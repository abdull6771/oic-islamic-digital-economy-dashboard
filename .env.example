# One setting selects the deployment. Build both from the same code and data.
SITE_EDITION=public
CONTACT_EMAIL=kinan@inceif.edu.my

# Keep shared mode until Supabase, email delivery and Kinan's account are ready.
INTERNAL_AUTH_MODE=shared

# Required only for the full deployment, as server-side environment variables.
# Never prefix these with VITE_ and never commit a real password.
# INTERNAL_SITE_USER=internal
# INTERNAL_SITE_PASSWORD=
# Generate a separate random signing secret of at least 32 characters.
# INTERNAL_SESSION_SECRET=

# Individual accounts and the private admin dashboard (server-only).
# INTERNAL_AUTH_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# Use a secret key, never an anon/publishable key, and never prefix with VITE_.
# SUPABASE_SECRET_KEY=
