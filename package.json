{
  "name": "oic-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --mode public --port 5181 --strictPort",
    "dev:full": "vite --mode full --port 5182 --strictPort",
    "build": "vite build",
    "build:public": "vite build --mode public --outDir dist-public",
    "build:full": "vite build --mode full --outDir dist-full",
    "preview": "vite preview",
    "preview:public": "vite preview --mode public --outDir dist-public --host 127.0.0.1 --port 5183 --strictPort",
    "preview:full": "vite preview --mode full --outDir dist-full --host 127.0.0.1 --port 5184 --strictPort",
    "validate:editions": "node scripts/validate-editions.mjs",
    "validate:auth": "node scripts/validate-internal-auth.mjs",
    "validate:accounts": "node scripts/validate-accounts.mjs",
    "accounts:bootstrap": "node scripts/bootstrap-accounts.mjs",
    "build:data": "node scripts/build-dataset.mjs",
    "validate:data": "node scripts/validate-dataset.mjs",
    "validate:reports": "node scripts/validate-country-reports.mjs",
    "validate:indicators": "node scripts/validate-indicator-drilldown.mjs",
    "validate:what-if": "node scripts/validate-what-if.mjs",
    "validate:quality": "node scripts/validate-data-quality.mjs",
    "build:history": "node scripts/build-history.mjs",
    "validate:history": "node scripts/validate-revision-history.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.2",
    "d3-scale": "^4.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2",
    "xlsx": "^0.18.5"
  }
}
